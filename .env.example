# offline is a deterministic development fixture, NOT an LLM.
AGENT_MODE=offline
AGENT_TRANSPORT=stdio
# Set AGENT_MODE=live only after choosing your provider.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=
MODEL_API_KEY=
# Install pip install -e '.[neural]' for local semantic retrieval; first run downloads weights.
# fixture is only for deterministic tests, NOT semantic retrieval.
RETRIEVAL_BACKEND=local
RERANK_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Set backend=remote to use the following remote adapters.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Optional rerank endpoint accepting {model,query,documents,top_n}.
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
# Optional Milvus URI; empty uses local in-memory vectors.
MILVUS_URI=
MILVUS_TOKEN=
# Local demo is single-user and binds loopback. Set a token before remote deployment.
AGENT_ACCESS_TOKEN=
AGENT_DATA_DIR=runtime
